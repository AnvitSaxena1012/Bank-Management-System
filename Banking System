def main():
   
   accounts={}

   print("\n--------------Welcome to Eagle County Bank-----------------------")

   while True:
      print("\n 1. Create Account")
      print("\n 2. Check Deposit Money")
      print("\n 3. Check Withdrawal Money")
      print("\n 4. Check Transaction History")
