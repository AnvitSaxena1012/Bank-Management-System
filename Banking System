      try:
        choice=(input("Select an Option [1 to 6] : "))

      except ValueError as val:
        print("Invalid Input, Please enter the valid number ")
        continue
    
      if choice == "1":

         name =(input("Welcome customer!! Please enter your name : "))
         balance = float(input("Enter your initial balance : "))

         account = BankAccount(name , balance)
         accounts[account.customer_id] = account

      elif choice == "2":

          cid = int(input("Enter your Customer ID : "))

          if cid in accounts:

             amount=float(input("Enter the amount to be deposited in ($) : "))

             accounts[cid].deposit(amount)

          else:
             print("Customer not found")

      elif choice == "3":

         cid = int(input("Enter your Customer ID : "))

         if cid in accounts:

            amount = float(input("Enter the amount to be withdrawn in ($) : "))

            accounts[cid].withdrawal(amount)

         else:
            print("Customer not found")

      elif choice == "4":

         cid = int(input("Enter your Customer ID : "))

         if cid in accounts:

            accounts[cid].show_history()

         
      elif choice == "5":

           cid = int(input("Enter your Customer ID : "))

           if cid in accounts:
              accounts[cid].check_balance()

      elif choice == "6":

         print("Thank You for visiting Eagle County Bank")
         print("We appretiate your patience. Hope you visit again")
         break

if __name__ == "__main__":
    main()
    